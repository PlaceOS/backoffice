# E2E Test Environment Configuration
# Copy this file to .env and configure as needed

# Set to 'true' to use mock data (default), 'false' for live environment
USE_MOCK=true

# Live environment configuration (only used when USE_MOCK=false)
# API_DOMAIN=placeos-dev.aca.im
# API_PORT=443
# API_PROTOCOL=https

# Base URL for E2E tests (defaults to http://localhost:4200)
# BASE_URL=http://localhost:4200

# Test user credentials for live environment
# TEST_USER_EMAIL=admin@example.com
# TEST_USER_PASSWORD=password

# Local backend suite (`bun run e2e:local`). Both URLs must be on a loopback
# host: the suite refuses any other host.
# E2E_BACKEND_URL=https://localhost:9543
# E2E_APP_URL=http://localhost:4216
# E2E_ADMIN_EMAIL=support@place.tech
# E2E_ADMIN_PASSWORD=development
# E2E_STAFF_PASSWORD=e2e-staff-development
